# Copy this file to .env in this same directory (packages/server/.env) and
# fill in real values. .env is gitignored — never commit your real one.

# --- Required ---
# Your Technitium DNS Server's web UI address (NOT the DNS port — the HTTP API port, default 5380)
NETINTEL_TECHNITIUM_URL=http://192.168.1.10:5380

# Generated in Technitium: Administration -> Sessions -> Create Token
NETINTEL_TECHNITIUM_TOKEN=

# --- Optional ---
# API server port
NETINTEL_PORT=8787

# Where the SQLite database lives. If unset, defaults to an OS-appropriate
# location: %ProgramData%\netintel on Windows, /var/lib/netintel on Linux
# (root), or ~/.local/share/netintel on Linux (non-root).
# NETINTEL_DATA_DIR=

# Overrides the exact DB file path instead of just the directory.
# NETINTEL_DB_PATH=

# --- Optional: alert policy email dispatch ---
# Only needed if you configure an alert policy channel like "email:you@example.com".
# NETINTEL_SMTP_HOST=
# NETINTEL_SMTP_PORT=587
# NETINTEL_SMTP_SECURE=false
# NETINTEL_SMTP_USER=
# NETINTEL_SMTP_PASS=
# NETINTEL_SMTP_FROM=netintel@localhost
